# PostgreSQL connection string for Prisma
# Replace USER and PASSWORD with your local database credentials
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bugify?schema=public

# Backend server port
PORT=5000

# Judge0 Code Execution Service Configuration
# Default public CE instance: https://ce.judge0.com
# If using RapidAPI: https://judge0-ce.p.rapidapi.com (and provide JUDGE0_API_KEY)
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# AI Bug Explanation Service Configuration (Server-side only)
# Supported providers: gemini (default), openai
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
